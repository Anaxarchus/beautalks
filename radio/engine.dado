//
// Picking the protocol engine a model names, and the safe write sequence
// every write goes through: back up the radio, write, read back, compare.
package radio

import "core:hash"
import "core:os/fs"
import "core:path"
import "core:strings"
import "core:time"

bool engine_known(^const Model m):
    return m^.engine == "uv17pro" || m^.engine == "uv5r"

// Identifies the radio and downloads its image. The caller #deletes it.
LinkError!ref []u8 download(^Link link, ^const Model m, Progress pr):
    if m^.engine == "uv17pro":
        return uv17_download(link, m, pr)
    if m^.engine == "uv5r":
        return uv5r_download(link, m, pr)
    fail LinkError.BAD_MODEL

// Identifies the radio and uploads `img`. Prefer safe_write, which also
// backs up and verifies.
LinkError!void upload(^Link link, ^const Model m, []u8 img, bool allow_untested, Progress pr):
    if m^.engine == "uv17pro":
        try uv17_upload(link, m, img, allow_untested, pr)
        return
    if m^.engine == "uv5r":
        try uv5r_upload(link, m, img, allow_untested, pr)
        return
    fail LinkError.BAD_MODEL

// The first offset where a read-back differs from what was written, or -1.
// For uv5r only the ranges CHIRP's guarded upload writes are compared
// (main 0x0008..0x1808 minus the two skipped holes); the rest of the image
// is not written by default and may legitimately differ.
i64 verify_mismatch(^const Model m, []u8 written, []u8 readback):
    if #len(written) != #len(readback):
        return 0
    if m^.engine == "uv5r":
        [3]Range main = (Range(0x0008, 0x0CF8), Range(0x0D08, 0x0DF8), Range(0x0E08, 0x1808))
        for r in main:
            for i in r.lo..<r.hi:
                if written[i] != readback[i]:
                    return i
        return -1
    for i in 0..<#len(written):
        if written[i] != readback[i]:
            return i
    return -1

// Phases of safe_write, reported through `phase` before each starts.
distinct enum i32 WritePhase:
    BACKUP = 1,
    WRITE = 2,
    VERIFY = 3,

type PhaseFn: void(rawptr, WritePhase)

// What the safe write sequence needs from a protocol engine, whichever it
// is: the built-in Dado engines (BuiltinEngine) or a scripted driver behind
// an adapter. `upload` is only ever called by safe_write_with, after the
// tested/override check and the backup.
trait Engine:
    // failures are LinkError numbers (plain `!`: see docs/DADO_NOTES.md)
    !ref []u8 download(^self, ^const Model m, Progress pr)
    !void upload(^self, ^const Model m, []u8 img, Progress pr)
    void pause(^self, i32 ms)

// The built-in engines over a Link.
type BuiltinEngine using Engine:
    Link link

    !ref []u8 download(^self, ^const Model m, Progress pr):
        return download(&self.link, m, pr)

    !void upload(^self, ^const Model m, []u8 img, Progress pr):
        // the gate already ran in safe_write_with; the engine re-checks it
        try upload(&self.link, m, img, true, pr)

    void pause(^self, i32 ms):
        self.link.sleep_ms(ms)

// The one way to write a radio: download its current image and save it to
// `backup_path` (refuse to go on if that fails), upload `img`, download
// again and compare. `allow_untested` is the user's explicit confirmation
// for a model not marked tested = write; backup and verify always run and
// cannot be skipped. `pause_ms` waits between the three sessions.
// Without a detection there is no fingerprint, so only a shipped `tested =
// write` definition passes the gate (gate.dado); otherwise the override.
LinkError!void safe_write_with(^Engine eng, ^const Model m, []u8 img, bool allow_untested, string8 backup_path, i32 pause_ms, PhaseFn phase, rawptr ctx, Progress pr):
    WriteStatus st
    if !gate_allows(m, "", nil, allow_untested, &st):
        fail LinkError.UNTESTED
    if #len(img) != m^.image_size:
        fail LinkError.IMAGE_SIZE
    if phase != nil:
        phase(ctx, WritePhase.BACKUP)
    try ref []u8 before = eng.download(m, pr) else code:
        fail LinkError(code)
    bool saved = save_backup(backup_path, m, before)
    #delete(before)
    if !saved:
        fail LinkError.BACKUP
    eng.pause(pause_ms)
    if phase != nil:
        phase(ctx, WritePhase.WRITE)
    try eng.upload(m, img, pr) else code:
        fail LinkError(code)
    eng.pause(pause_ms)
    if phase != nil:
        phase(ctx, WritePhase.VERIFY)
    try ref []u8 after = eng.download(m, pr) else code:
        fail LinkError(code)
    i64 bad = verify_mismatch(m, img, after)
    #delete(after)
    if bad >= 0:
        fail LinkError.VERIFY

// A new backup file name for model `m`: <data_dir>/backups/<model id>/
// <UTC stamp>.img (the directories are made). The caller #deletes it; nil
// when the directory cannot be made.
ref []char8 new_backup_path(string8 data_dir, ^const Model m):
    ref []char8 dir = path.join(data_dir, "backups", m^.id)
    try fs.make_dirs(dir) else:
        #delete(dir)
        return nil
    time.DateTime t = time.utc(time.unix_nanos())
    strings.Builder b = strings.builder(32)
    append_padded(&b, t.year, 4)
    append_padded(&b, i64(t.month), 2)
    append_padded(&b, i64(t.day), 2)
    strings.append_char(&b, 'T')
    append_padded(&b, i64(t.hour), 2)
    append_padded(&b, i64(t.minute), 2)
    append_padded(&b, i64(t.second), 2)
    strings.append(&b, "Z.img")
    ref []char8 out = path.join(dir, strings.text(b))
    #delete(b)
    #delete(dir)
    return out

// Writes a backup image to `backup_path` and a `.txt` sidecar beside it
// (model, engine, size, SHA-256, UTC time). False when the image is not on
// disk afterwards (the sidecar is best effort). Used by every write path.
bool save_backup(string8 backup_path, ^const Model m, []u8 img):
    try fs.write_bytes(backup_path, img) else:
        return false
    if !fs.exists(backup_path):
        return false
    strings.Builder b = strings.builder(256)
    strings.append(&b, "beautalks backup\nmodel = ")
    strings.append(&b, m^.id)
    strings.append(&b, "\nradio = ")
    strings.append(&b, m^.vendor)
    strings.append(&b, " ")
    strings.append(&b, m^.name)
    strings.append(&b, "\nengine = ")
    strings.append(&b, m^.engine)
    strings.append(&b, "\nbytes = ")
    append_int(&b, #len(img))
    strings.append(&b, "\nsha256 = ")
    hash.Sha256Digest dg = hash.sha256(img)
    ref []char8 hx = hash.hex(dg)
    strings.append(&b, hx)
    #delete(hx)
    strings.append(&b, "\nsaved_unix = ")
    append_int(&b, time.unix())
    strings.append(&b, "\n")
    ref []char8 side = strings.concat(strings.trim_suffix(backup_path, ".img"), ".txt")
    try fs.write_file(side, strings.text(b)) else:
        _ = 0
    #delete(side)
    #delete(b)
    return true

// The safe write with the built-in engine for the model. One session in
// both families: uv5r explicitly (uv5r_safe_session); uv17pro because
// every phase finds the session the first one opened and reuses it.
LinkError!void safe_write(^Link link, ^const Model m, []u8 img, bool allow_untested, string8 backup_path, i32 pause_ms, PhaseFn phase, rawptr ctx, Progress pr):
    if m^.engine == "uv5r":
        WriteStatus st
        if !gate_allows(m, "", nil, allow_untested, &st):
            fail LinkError.UNTESTED
        if #len(img) != m^.image_size:
            fail LinkError.IMAGE_SIZE
        try uv5r_safe_session(link, m, img, backup_path, pause_ms, phase, ctx, pr)
        return
    BuiltinEngine eng
    eng.link = link
    try safe_write_with(&eng, m, img, allow_untested, backup_path, pause_ms, phase, ctx, pr)
