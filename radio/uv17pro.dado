//
// The UV-17Pro family protocol (Baofeng UV-5RM, UV-17Pro, K5-Plus, ...),
// ported from CHIRP's baofeng_uv17Pro.py. 115200 8N1.
//   ident: "PROGRAM....U" -> 06; then magics, each answered with N bytes
//   read:  52 aH aL 40 -> 4-byte header + 0x40 scrambled bytes
//   write: 57 aH aL 40 + 0x40 scrambled bytes -> 06
// The image is the model's regions concatenated, descrambled.
//
// Sessions (owner's UV-5RM, probed on hardware): after the ident the radio
// stays in its programming session until it is power-cycled. In a session
// it executes every R and W frame it can parse out of what arrives and
// ignores other bytes; it does NOT accept a new ident (which it would parse
// as commands: "PROGRAM..." holds `R O G R`, a read). So before any ident
// we probe with a harmless read of block 0 (`52 00 00 40`); an answer
// `52 00 00 40` + 64 bytes means a session is open and is reused as is.
//
// Byte audit (nothing we send outside a write may parse as a W frame,
// 0x57 'W'):
//  * the probe 52 00 00 40: no 0x57.
//  * every PROGRAM...U ident in the model files: no 0x57 ('W'); they hold
//    'R' (0x52), so in an open session they cause reads, never writes.
//  * the magics 'F' 46, 'M' 4D and the three SEND strings in the model
//    files: no 0x57 and no 0x52.
//  * the UV-5R magics detection sends at 9600 (50 BB FF ...): no 0x57 or
//    0x52 as bytes; at 115200 a 9600 byte arrives as framing junk of
//    unpredictable value, which is why detection probes for an open session
//    at 115200 FIRST and stops there when one answers.
//  * read frames 52 aH aL 40 may hold 0x57 as an address byte (0x5700..);
//    they are only sent inside a session we opened or confirmed, in step.
// models_test checks the idents and magics of every model file for 0x57.

// Engine code depends only on Link, Model and Progress (see link.dado).
package radio

// What the radio said while identifying.
type Uv17Hello:
    // which of the model's idents answered (index into `ident` words)
    i64 ident_index
    // replies to the magics sent so far ('F' -> 16 bytes, 'M' -> model text)
    [32]u8 f_reply
    i64 f_len
    [32]u8 m_reply
    i64 m_len
    // how many of the model's magics were sent
    i64 magics_sent
    // an open session was found and reused (no ident sent)
    bool reused

// CHIRP's _crypt: XOR with the 4-byte key, skipping 0x00, 0xFF, the key byte,
// its complement, and every position whose key byte is a space. The same
// function scrambles and descrambles.
void uv17_crypt([]u8 key, []u8 data):
    if #len(key) != 4:
        return
    for i in 0..<#len(data):
        u8 k = key[i % 4]
        u8 b = data[i]
        if k != 0x20 && b != 0x00 && b != 0xFF && b != k && b != (k ~ 0xFF):
            data[i] = b ~ k

// The model's key: 4 bytes, or 0 bytes for "none".
i64 uv17_key(^const Model m, ^[4]u8 key):
    if #len(m^.key) == 0 || m^.key == "none":
        return 0
    [8]u8 tmp
    i64 n = decode_bytes(m^.key, tmp[:])
    if n != 4:
        return -1
    for i in 0..<4:
        key^[i] = tmp[i]
    return 4

// Sends one magic and reads its reply (up to `reply` bytes; a short reply is
// accepted: the 'M' answer differs between models). Answers the count.
private LinkError!i64 send_magic(^Link link, []u8 magic, []u8 reply, i32 timeout_ms):
    try send_all(link, magic)
    try i64 n = link.recv(reply, timeout_ms) else:
        fail LinkError.IO
    return n

// Reads and throws away whatever arrives until `quiet_ms` pass in silence
// (at most ~3 s).
void drain(^Link link, i32 quiet_ms):
    [256]u8 junk
    for _ in 0..<40:
        try i64 n = link.recv(junk[:], quiet_ms) else:
            return
        if n == 0:
            return

// One probe: 1 session open, 0 silence, -1 a partial or garbled reply.
private i32 probe_once(^Link link):
    link.discard()
    [4]u8 probe = (0x52, 0x00, 0x00, 0x40)
    try send_all(link, probe[:]) else:
        return 0
    [68]u8 reply
    try i64 n = link.recv(reply[:], 600) else:
        return 0
    if n == 0:
        return 0
    if n == 68 && reply[0] == 0x52 && reply[1] == 0x00 && reply[2] == 0x00 && reply[3] == 0x40:
        drain(link, 100)
        return 1
    return -1

// Whether a programming session is already open: a read of block 0 is
// answered. A partial or garbled answer is drained (300 ms of silence) and
// the probe tried once more. Leaves nothing unread behind.
bool uv17_session_open(^Link link):
    i32 r = probe_once(link)
    if r < 0:
        drain(link, 300)
        r = probe_once(link)
        if r < 0:
            drain(link, 300)
    return r == 1

// The fingerprint of an ident sent into an open session: the radio parses
// "PROGRAM..." as commands and answers `R O G R` (52 4F 47 52 ...) as a read.
bool uv17_in_session_reply(i32 first_byte):
    return first_byte == 0x52

// Puts the radio in program mode: each of the model's idents is tried until
// one is answered with 06, then the first `upto` magics are sent (all when
// upto < 0). Detection stops after 'F' and 'M' (upto = 2).
LinkError!Uv17Hello uv17_hello(^Link link, ^const Model m, i64 upto):
    Uv17Hello h
    h.ident_index = -1
    if uv17_session_open(link):
        // already in a session (not power-cycled since the last one): reuse it
        h.reused = true
        h.magics_sent = word_count(m^.magics)
        return h
    i64 nid = word_count(m^.ident)
    if nid == 0:
        fail LinkError.BAD_MODEL
    bool saw_data = false
    for round in 0..<IDENT_TRIES:
        if round > 0:
            link.discard()
            link.sleep_ms(IDENT_RETRY_MS)
            link.discard()
        for i in 0..<nid:
            string8 id = word_at(m^.ident, i)
            link.discard()
            [32]u8 idb
            i64 n = decode_bytes(id, idb[:])
            if n <= 0:
                fail LinkError.BAD_MODEL
            try send_all(link, idb[0..<n])
            i32 ack = link.recv_byte(1500)
            if ack >= 0:
                saw_data = true
            if ack == 0x06:
                h.ident_index = i
                break
            if ack >= 0:
                // anything but 06: was a session open after all (the probe
                // lost on the cable)? Never send another ident into one.
                drain(link, 300)
                if uv17_session_open(link):
                    h.reused = true
                    h.magics_sent = word_count(m^.magics)
                    return h
        if h.ident_index >= 0:
            break
    if h.ident_index < 0:
        if saw_data:
            fail LinkError.BAD_REPLY
        fail LinkError.NO_ANSWER
    try uv17_more_magics(link, m, &h, upto)
    return h

// Sends the model's magics from where `h` stopped up to `upto` (all when < 0).
LinkError!void uv17_more_magics(^Link link, ^const Model m, ^Uv17Hello h, i64 upto):
    i64 total = word_count(m^.magics)
    i64 stop = total if upto < 0 || upto > total else upto
    for i in h^.magics_sent..<stop:
        [64]u8 mb
        (i64 n, i64 want) = magic_at(m^.magics, i, mb[:])
        if n <= 0 || want <= 0 || want > 32:
            fail LinkError.BAD_MODEL
        [32]u8 reply
        try i64 got = send_magic(link, mb[0..<n], reply[0..<want], 1500)
        if got == 0:
            fail LinkError.NO_ANSWER
        if mb[0] == 0x46 && n == 1:
            for k in 0..<got:
                h^.f_reply[k] = reply[k]
            h^.f_len = got
        else if mb[0] == 0x4D && n == 1:
            for k in 0..<got:
                h^.m_reply[k] = reply[k]
            h^.m_len = got
        else if got != want:
            fail LinkError.BAD_REPLY
        h^.magics_sent = i + 1

// Reads every region after the radio is in program mode. The caller
// #deletes the image.
LinkError!ref []u8 uv17_read(^Link link, ^const Model m, Progress pr):
    [4]u8 key
    i64 kn = uv17_key(m, &key)
    if kn < 0 || m^.image_size <= 0:
        fail LinkError.BAD_MODEL
    i64 block = i64(m^.block)
    ref []u8 img = #make([]u8, m^.image_size)
    i64 at = 0
    i64 r = 0
    for at < m^.image_size:
        (i64 addr, i64 len) = region_at(m, r)
        if addr < 0:
            break
        r += 1
        i64 a = addr
        for a < addr + len:
            [4]u8 frame = (0x52, u8((a >> 8) & 0xFF), u8(a & 0xFF), u8(block))
            try send_all(link, frame[:]) else why:
                #delete(img)
                fail why
            [260]u8 buf
            try recv_exact(link, buf[0..<block + 4], 1500) else why:
                #delete(img)
                fail why
            if at + block > m^.image_size:
                #delete(img)
                fail LinkError.BAD_MODEL
            for k in 0..<block:
                img[at + k] = buf[4 + k]
            if kn == 4:
                uv17_crypt(key[:], img[at..<at + block])
            at += block
            a += block
            try step(pr, at, m^.image_size) else why:
                #delete(img)
                fail why
    if at != m^.image_size:
        #delete(img)
        fail LinkError.BAD_MODEL
    return img

// Identifies and downloads. The caller #deletes the image.
LinkError!ref []u8 uv17_download(^Link link, ^const Model m, Progress pr):
    try Uv17Hello _ = uv17_hello(link, m, -1)
    return uv17_read(link, m, pr)

// Writes `img` after the radio is in program mode.
LinkError!void uv17_write(^Link link, ^const Model m, []u8 img, Progress pr):
    [4]u8 key
    i64 kn = uv17_key(m, &key)
    if kn < 0:
        fail LinkError.BAD_MODEL
    if #len(img) != m^.image_size:
        fail LinkError.IMAGE_SIZE
    i64 block = i64(m^.block)
    if block <= 0 || block > 255:
        fail LinkError.BAD_MODEL
    i64 at = 0
    i64 r = 0
    for at < m^.image_size:
        (i64 addr, i64 len) = region_at(m, r)
        if addr < 0:
            break
        r += 1
        i64 a = addr
        for a < addr + len:
            [260]u8 frame
            frame[0] = 0x57
            frame[1] = u8((a >> 8) & 0xFF)
            frame[2] = u8(a & 0xFF)
            frame[3] = u8(block)
            for k in 0..<block:
                frame[4 + k] = img[at + k]
            if kn == 4:
                uv17_crypt(key[:], frame[4..<4 + block])
            try send_all(link, frame[0..<4 + block])
            i32 ack = link.recv_byte(1500)
            if ack < 0:
                fail LinkError.NO_ANSWER
            if ack != 0x06:
                fail LinkError.REFUSED
            at += block
            a += block
            report(pr, at, m^.image_size)

// Identifies and uploads. Refused unless the model is tested for writing,
// or the user explicitly confirmed writing an untested model (`allow_untested`;
// the caller must still back up first and verify after).

LinkError!void uv17_upload(^Link link, ^const Model m, []u8 img, bool allow_untested, Progress pr):
    if m^.tested != Tested.WRITE && !allow_untested:
        fail LinkError.UNTESTED
    if #len(img) != m^.image_size:
        fail LinkError.IMAGE_SIZE
    try Uv17Hello _ = uv17_hello(link, m, -1)
    try uv17_write(link, m, img, pr)
