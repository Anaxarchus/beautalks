//
// Anti-aliased strokes and arcs as geometry: the check mark, progress arcs,
// chevrons. Each stroke is a core strip at full alpha with a one-pixel
// fringe strip on each side whose outer vertices are transparent (the
// classic "AA fringe", as Dear ImGui and NanoVG do it). It goes through
// app:draw's per-vertex-colour primitive with the atlas's white block bound,
// so it batches with everything else.
package btui

import "app:draw"

private [2]f32 white_uv():
    [4]f32 w = white_src()
    return [w[0] / f32(ATLAS_SIZE), w[1] / f32(ATLAS_SIZE)]

private void quad4([2]f32 a, [2]f32 b, [2]f32 c, [2]f32 d, [4]u8 ca, [4]u8 cb, [4]u8 cc, [4]u8 cd):
    if ca[3] == 0 && cb[3] == 0 && cc[3] == 0 && cd[3] == 0:
        return
    [2]f32 uv = white_uv()
    [4][2]f32 pts = [a, b, c, d]
    [4][4]u8 cols = [ca, cb, cc, cd]
    [4][2]f32 uvs = [uv, uv, uv, uv]
    draw.primitive(cur_item(), pts[:], cols[:], uvs[:], atlas_texture())
    count_quad()

private void tri3([2]f32 a, [2]f32 b, [2]f32 c, [4]u8 ca, [4]u8 cb, [4]u8 cc):
    [2]f32 uv = white_uv()
    [3][2]f32 pts = [a, b, c]
    [3][4]u8 cols = [ca, cb, cc]
    [3][2]f32 uvs = [uv, uv, uv]
    draw.primitive(cur_item(), pts[:], cols[:], uvs[:], atlas_texture())
    count_quad()

// Stroke a polyline given in dp, `width` dp, with miter joins and round caps
// (when `round_caps`). Up to 256 points.
void stroke_path([][2]f32 pts_dp, f32 width, [4]u8 col, bool round_caps = true):
    i32 n = i32(#len(pts_dp))
    if n < 2 || col[3] == 0:
        return
    if n > 256:
        n = 256
    f32 s = scale()
    [256][2]f32 p
    for i in 0..<n:
        p[i] = [pts_dp[i][0] * s, pts_dp[i][1] * s]
    f32 w = width * s
    f32 core = maxf(0.0, w * 0.5 - 0.5)
    f32 fr = w * 0.5 + 0.5
    [4]u8 c1 = col
    if w < 1.0:
        c1 = alpha(col, w)
    [4]u8 c0 = alpha(col, 0.0)
    // per-vertex miter normals
    [256][2]f32 nm
    [256]f32 ml
    for i in 0..<n:
        [2]f32 na = [0.0, 0.0]
        [2]f32 nb = [0.0, 0.0]
        bool has_a = i > 0
        bool has_b = i < n - 1
        if has_a:
            na = seg_normal(p[i - 1], p[i])
        if has_b:
            nb = seg_normal(p[i], p[i + 1])
        [2]f32 m = na
        if has_a && has_b:
            m = [na[0] + nb[0], na[1] + nb[1]]
            f32 l = sqrtf(m[0] * m[0] + m[1] * m[1])
            if l < 0.0001:
                m = na
            else:
                m = [m[0] / l, m[1] / l]
        else if has_b:
            m = nb
        f32 d = m[0] * (na[0] if has_a else nb[0]) + m[1] * (na[1] if has_a else nb[1])
        nm[i] = m
        ml[i] = 1.0 / maxf(0.25, d)
    for i in 0..<(n - 1):
        i32 j = i32(i) + 1
        [2]f32 a = p[i]
        [2]f32 b = p[j]
        [2]f32 na = [nm[i][0] * ml[i], nm[i][1] * ml[i]]
        [2]f32 nb = [nm[j][0] * ml[j], nm[j][1] * ml[j]]
        [2]f32 alo = [a[0] + na[0] * fr, a[1] + na[1] * fr]
        [2]f32 ali = [a[0] + na[0] * core, a[1] + na[1] * core]
        [2]f32 ari = [a[0] - na[0] * core, a[1] - na[1] * core]
        [2]f32 aro = [a[0] - na[0] * fr, a[1] - na[1] * fr]
        [2]f32 blo = [b[0] + nb[0] * fr, b[1] + nb[1] * fr]
        [2]f32 bli = [b[0] + nb[0] * core, b[1] + nb[1] * core]
        [2]f32 bri = [b[0] - nb[0] * core, b[1] - nb[1] * core]
        [2]f32 bro = [b[0] - nb[0] * fr, b[1] - nb[1] * fr]
        quad4(alo, blo, bli, ali, c0, c0, c1, c1)
        if core > 0.0:
            quad4(ali, bli, bri, ari, c1, c1, c1, c1)
        quad4(ari, bri, bro, aro, c1, c1, c0, c0)
    if round_caps:
        disc_px(p[0][0], p[0][1], w * 0.5, col, true, seg_dir(p[1], p[0]))
        disc_px(p[n - 1][0], p[n - 1][1], w * 0.5, col, true, seg_dir(p[n - 2], p[n - 1]))

private [2]f32 seg_dir([2]f32 a, [2]f32 b):
    f32 dx = b[0] - a[0]
    f32 dy = b[1] - a[1]
    f32 l = sqrtf(dx * dx + dy * dy)
    if l < 0.0001:
        return [1.0, 0.0]
    return [dx / l, dy / l]

private [2]f32 seg_normal([2]f32 a, [2]f32 b):
    [2]f32 d = seg_dir(a, b)
    return [0.0 - d[1], d[0]]

// An anti-aliased disc in px; `half` draws only the half facing `dir`.
private void disc_px(f32 cxp, f32 cyp, f32 r, [4]u8 col, bool half, [2]f32 dir):
    if r <= 0.2:
        return
    i32 segs = clampi(i32(r * 2.0) + 8, 10, 48)
    f32 core = maxf(0.0, r - 0.5)
    f32 fr = r + 0.5
    [4]u8 c0 = alpha(col, 0.0)
    f32 a0 = 0.0
    f32 span = 2.0 * PI
    if half:
        // from the left normal of dir, sweeping through dir, to the right
        a0 = atan2f(dir[1], dir[0]) - PI * 0.5
        span = PI
        segs = segs / 2 + 2
    [2]f32 c = [cxp, cyp]
    for i in 0..<segs:
        f32 t0 = a0 + span * f32(i32(i)) / f32(segs)
        f32 t1 = a0 + span * f32(i32(i) + 1) / f32(segs)
        [2]f32 u0 = [cosf(t0), sinf(t0)]
        [2]f32 u1 = [cosf(t1), sinf(t1)]
        [2]f32 i0 = [cxp + u0[0] * core, cyp + u0[1] * core]
        [2]f32 i1 = [cxp + u1[0] * core, cyp + u1[1] * core]
        [2]f32 o0 = [cxp + u0[0] * fr, cyp + u0[1] * fr]
        [2]f32 o1 = [cxp + u1[0] * fr, cyp + u1[1] * fr]
        if core > 0.0:
            tri3(c, i0, i1, col, col, col)
        quad4(i0, o0, o1, i1, col, c0, c0, col)

private f32 atan2f(f32 y, f32 x):
    return f32(math_angle(f64(y), f64(x)))

// An arc of a circle centred (cx, cy) dp, radius r dp, from angle a0 to a1
// (radians, 0 = 3 o'clock, clockwise because y grows down), stroked `width` dp.
void stroke_arc(f32 cxd, f32 cyd, f32 r, f32 a0, f32 a1, f32 width, [4]u8 col, bool round_caps = true):
    f32 span = a1 - a0
    if absf(span) < 0.001:
        return
    i32 segs = clampi(i32(absf(span) * r * scale() / 3.0) + 2, 3, 200)
    [256][2]f32 pts
    for i in 0..=segs:
        f32 a = a0 + span * f32(i32(i)) / f32(segs)
        pts[i] = [cxd + cosf(a) * r, cyd + sinf(a) * r]
    stroke_path(pts[0..<(segs + 1)], width, col, round_caps)
