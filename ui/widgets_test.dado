@test
// beautalks - radio programming software
// Copyright (C) 2026 Anaxarchus. Licensed under the GNU GPL v3 or later.
//
// Widget logic, headless: clicks, toggles, keyboard focus order, a modal
// dialog blocking the page under it, menus by keyboard, text editing.
package btui

private i32 g_clicks_a
private i32 g_clicks_b
private bool g_check
private bool g_dialog_ok
private i32 g_menu_choice = -1
private Field g_f
private i32 g_edits
private bool g_show_dialog

[3]string8 ITEMS = ["Alpha", "Bravo", "Charlie"]

private void frame():
    if button("A", rect(10.0, 10.0, 100.0, 40.0)):
        g_clicks_a += 1
    if button("B", rect(120.0, 10.0, 100.0, 40.0)):
        g_clicks_b += 1
    _ = checkbox("Check", 10.0, 60.0, &g_check)
    FieldOut o = text_field("f", rect(10.0, 120.0, 300.0, 56.0), &g_f, field_opts("Name"))
    if o.changed:
        g_edits += 1
    if menu_is_open("m"):
        i32 c = menu("m", ITEMS[:], -1, 200.0)
        if c >= 0:
            g_menu_choice = c
    if g_show_dialog:
        (Rect body, bool open) = dialog_begin("d", "Title", 400.0, 40.0)
        if open:
            Rect acts = dialog_actions(body)
            if button("OK", rect(acts.x, acts.y, 80.0, 40.0)):
                g_dialog_ok = true
            dialog_end()

private void step():
    headless_frame(0.016)

// Move there, let hover settle, then click.
private void click(f32 x, f32 y):
    push_mouse_move(x, y)
    step()
    push_click(x, y)
    step()
    step()

// The field focused, holding `text`, caret at the end.
private void field_with(string8 text):
    set_focus(id("f#tf"))
    field_set(&g_f, text)
    step()

private bool field_keys_test(bool mac):
    bool ok = true
    string8 keys = "Cmd" if mac else "Ctrl"
    field_with("")
    i32 e0 = g_edits
    push_text("Truck radio")
    step()
    ok = #expect(field_text(&g_f) == "Truck radio" && g_edits == e0 + 1, "typing (", keys, "): '", field_text(&g_f), "'") && ok
    // select a word with Shift+Left and replace it
    field_with("Truck radio")
    for _ in 0..<5:
        push_key(KEY_LEFT, MOD_SHIFT)
    step()
    push_text("van")
    step()
    ok = #expect(field_text(&g_f) == "Truck van", "replace the selection: '", field_text(&g_f), "'") && ok
    // word delete (Alt on macOS, Ctrl elsewhere)
    field_with("Truck van")
    push_key(KEY_BACKSPACE, word_mod())
    step()
    ok = #expect(field_text(&g_f) == "Truck ", "word backspace (", keys, "): '", field_text(&g_f), "'") && ok
    // select all + cut
    field_with("Truck ")
    clipboard_set("")
    push_key(KEY_A, cmd_mod())
    push_key(KEY_X, cmd_mod())
    step()
    ok = #expect(field_text(&g_f) == "" && clipboard_get() == "Truck ", keys, "+A, ", keys, "+X cut: '", field_text(&g_f), "' clip '", clipboard_get(), "'") && ok
    // paste twice
    field_with("")
    clipboard_set("Truck ")
    push_key(KEY_V, cmd_mod())
    push_key(KEY_V, cmd_mod())
    step()
    ok = #expect(field_text(&g_f) == "Truck Truck ", keys, "+V twice: '", field_text(&g_f), "'") && ok
    // the other modifier is not a command: no paste
    field_with("")
    push_key(KEY_V, MOD_SUPER if !mac else MOD_CTRL)
    step()
    ok = #expect(field_text(&g_f) == "", "the other modifier+V doesn't paste (", keys, " mapping)") && ok
    return ok

i32 test():
    bool ok = #expect(headless_up(800.0, 600.0, 1.0, frame), "headless up")
    _ = load_assets()
    step()
    // a click on A
    click(50.0, 30.0)
    ok = #expect(g_clicks_a == 1 && g_clicks_b == 0, "click A: ", g_clicks_a, " ", g_clicks_b) && ok
    // pressing on A and releasing outside it is not a click
    push_mouse_move(50.0, 30.0)
    step()
    push_mouse_button(0, true, 50.0, 30.0)
    step()
    push_mouse_button(0, false, 500.0, 500.0)
    step()
    step()
    ok = #expect(g_clicks_a == 1, "release outside is not a click") && ok
    // the checkbox toggles (its label is part of the target)
    click(80.0, 80.0)
    ok = #expect(g_check, "checkbox on") && ok
    click(25.0, 80.0)
    ok = #expect(!g_check, "checkbox off") && ok
    // keyboard: Tab to the first focusable, Enter presses it, Tab again, Space
    clear_focus()
    push_key(KEY_TAB, 0)
    step()
    ok = #expect(focus_id() == id("A") && focus_visible(), "Tab focuses A") && ok
    push_key(KEY_ENTER, 0)
    step()
    ok = #expect(g_clicks_a == 2, "Enter presses the focused button") && ok
    push_key(KEY_TAB, 0)
    step()
    push_key(KEY_SPACE, 0)
    step()
    ok = #expect(g_clicks_b == 1, "Tab then Space presses B") && ok
    push_key(KEY_TAB, MOD_SHIFT)
    step()
    ok = #expect(focus_id() == id("A"), "Shift+Tab goes back") && ok
    // text field: click to focus
    click(100.0, 148.0)
    ok = #expect(focus_id() == id("f#tf"), "click focuses the field") && ok
    // editing keys, with this system's key mapping and then the other one
    // (macOS: Cmd for commands, Alt for words; elsewhere Ctrl for both). Each
    // step sets its own starting text, so a failure doesn't cascade. The
    // clipboard in a headless run is the toolkit's own (never the system
    // pasteboard), so this is the same on every system.
    bool native = mac_keys()
    for pass in 0..<2:
        bool mac = native if pass == 0 else !native
        set_mac_keys(mac)
        ok = field_keys_test(mac) && ok
    set_mac_keys(native)
    // the number filter, driving the editing core directly
    Field nf
    field_set(&nf, "146")
    push_text("x.5")
    input_begin_frame()
    _ = field_keys(&nf, accept_number)
    ok = #expect(field_text(&nf) == "146.5", "numeric filter: '", field_text(&nf), "'") && ok
    // a menu by keyboard: Down, Down, Enter chooses the second item
    menu_open("m", rect(10.0, 300.0, 200.0, 40.0), -1)
    step()
    push_key(KEY_DOWN, 0)
    push_key(KEY_DOWN, 0)
    step()
    push_key(KEY_ENTER, 0)
    step()
    ok = #expect(g_menu_choice == 1 && !menu_is_open("m"), "menu keyboard choice: ", g_menu_choice) && ok
    // a dialog blocks the page: a click where A is lands on the scrim
    g_show_dialog = true
    dialog_open("d")
    step()
    step()
    i32 before = g_clicks_a
    click(50.0, 30.0)
    ok = #expect(g_clicks_a == before, "modal blocks the page") && ok
    ok = #expect(!dialog_is_open("d"), "a click on the scrim closes the dialog") && ok
    // Esc closes it too
    dialog_open("d")
    step()
    push_key(KEY_ESCAPE, 0)
    step()
    ok = #expect(!dialog_is_open("d"), "Esc closes the dialog") && ok
    return 0 if ok else 1
