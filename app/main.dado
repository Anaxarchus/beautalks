// beautalks, the desktop program: a native sokol window drawn with the btui
// toolkit (ui/), doing every radio operation through the radio library on
// a worker thread.
//
//   dado build app -o build/beautalks-app && ./build/beautalks-app
//   options: --models DIR --data DIR --library DIR --drivers DIR --builtin
//            --port P --no-watch --dark --light --page NAME
//   macOS (Dado rc.9): ./build.sh app -o build/beautalks-app (Apple clang, DADO_CFLAGS="-x none -ObjC").
package main

import "core:fmt"
import "core:os"
import "core:strings"
import btui "../ui"
import "../radio"

const i32 PAGE_RADIO = 0
const i32 PAGE_CHANNELS = 1
const i32 PAGE_PROFILES = 2
const i32 PAGE_RADIOS = 3
const i32 PAGE_BACKUPS = 4
const i32 PAGE_SETTINGS = 5

i32 g_page
bool g_watch = true
bool g_theme_forced
i32 g_theme_choice
ref []char8 g_arg_models
ref []char8 g_arg_data
ref []char8 g_arg_library
ref []char8 g_start_page

void app_init():
    if !btui.load_assets():
        fmt.eprintln("beautalks: assets missing (run from the project, or set BEAUTALKS_ASSETS)")
    if !g_theme_forced:
        btui.follow_system_theme()
    dirs_init(g_arg_models, g_arg_data, g_arg_library)
    // the shipped channel sets, then the user's own (which add to them)
    string8 shipped = shipped_dir("data")
    if #len(shipped) > 0:
        library_load(shipped)
    library_load(g_data_dir)
    if #len(g_models) == 0:
        fmt.eprintln("beautalks: no model definitions in ", g_models_dir)
    channels_init()
    profiles_init()
    if g_watch && !g_headless_test:
        watch_start()
    if #len(g_port_override) > 0:
        ports_set_one(g_port_override, true)
    if #len(g_start_page) > 0:
        page_by_name(g_start_page)

string8 path_join2(string8 a, string8 b):
    return #format(a, "/", b)

void page_by_name(string8 n):
    if n == "channels":
        g_page = PAGE_CHANNELS
    else if n == "profiles":
        g_page = PAGE_PROFILES
    else if n == "radios":
        g_page = PAGE_RADIOS
    else if n == "backups":
        g_page = PAGE_BACKUPS
    else if n == "settings":
        g_page = PAGE_SETTINGS

void app_frame():
    ^btui.Scheme t = btui.theme()
    btui.Rect vp = btui.viewport()
    btui.fill_rect(vp, t.surface_container_low)
    collect_job()
    shot_step()
    watch_step()
    probe_step()
    btui.Rect area = vp
    btui.Rect rail = btui.cut_left(&area, 88.0)
    nav_rail(rail)
    // the page sits on a sheet with a rounded corner, as in the gallery
    btui.Rect sheet = btui.inset4(area, 0.0, 8.0, 8.0, 8.0)
    btui.fill_rrect(sheet, 16.0, t.surface)
    btui.push_clip(sheet)
    if write_flow_active():
        write_flow_page(sheet)
    else if verify_flow_active():
        verify_flow_page(sheet)
    else if g_page == PAGE_RADIO:
        radio_page(sheet)
    else if g_page == PAGE_CHANNELS:
        channels_page(sheet)
    else if g_page == PAGE_PROFILES:
        profiles_page(sheet)
    else if g_page == PAGE_RADIOS:
        radios_page(sheet)
    else if g_page == PAGE_BACKUPS:
        backups_page(sheet)
    else:
        settings_page(sheet)
    btui.pop_clip()
    dialogs()
    if btui.snackbar(sheet):
        snack_action()
    global_keys()
    if job_busy():
        btui.animating()

private void nav_rail(btui.Rect rail):
    _ = btui.image("appicon", rail.x + 24.0, 16.0, 40.0)
    f32 y = 84.0
    bool busy_flow = write_flow_active() || verify_flow_active()
    if btui.rail_item("cell_tower", "Radio", rail.x + 4.0, y, g_page == PAGE_RADIO && !busy_flow, "", job_busy() && !job().quiet):
        leave_flows()
        g_page = PAGE_RADIO
    y = y + 72.0
    string8 cbadge = ""
    if g_doc.open && problem_count() > 0:
        cbadge = #format(problem_count())
    if btui.rail_item("table_rows", "Channels", rail.x + 4.0, y, g_page == PAGE_CHANNELS && !busy_flow, cbadge, #len(cbadge) > 0):
        leave_flows()
        g_page = PAGE_CHANNELS
    y = y + 72.0
    if btui.rail_item("library_books", "Profiles", rail.x + 4.0, y, g_page == PAGE_PROFILES && !busy_flow):
        leave_flows()
        g_page = PAGE_PROFILES
    y = y + 72.0
    if btui.rail_item("radio", "Radios", rail.x + 4.0, y, g_page == PAGE_RADIOS && !busy_flow):
        leave_flows()
        g_page = PAGE_RADIOS
    y = y + 72.0
    if btui.rail_item("history", "Backups", rail.x + 4.0, y, g_page == PAGE_BACKUPS && !busy_flow):
        leave_flows()
        g_page = PAGE_BACKUPS
    y = y + 72.0
    if btui.rail_item("settings", "Settings", rail.x + 4.0, y, g_page == PAGE_SETTINGS && !busy_flow):
        leave_flows()
        g_page = PAGE_SETTINGS

private void leave_flows():
    // a running transfer keeps its page; finished flows close
    if job_busy():
        return
    write_flow_close()
    verify_flow_close()

private void global_keys():
    if btui.take_key(btui.KEY_Z, btui.MOD_CMD):
        if g_doc.open && doc_undo():
            btui.snackbar_show("Undone")
    if btui.take_key(btui.KEY_Z, btui.MOD_CMD | btui.MOD_SHIFT) || btui.take_key(btui.KEY_Y, btui.MOD_CMD):
        if g_doc.open && doc_redo():
            btui.snackbar_show("Redone")
    if btui.take_key(btui.KEY_D, btui.MOD_CMD | btui.MOD_SHIFT):
        btui.set_dark(!btui.is_dark())

// ── the port watcher, each frame ─────────────────────────────────────────────

ref []char8 g_new_port
bool g_new_port_prompt

private void watch_step():
    (string8 p, bool auto) = watch_poll()
    if #len(p) == 0:
        return
    using app_keep():
        #delete(g_new_port)
        g_new_port = strings.clone(p)
    // never probe mid-transfer or under an open dialog
    if auto && g_probe_on:
        // the presence probe looks for the radio (quietly, until it answers)
        probe_reset()
        btui.snackbar_show(#format("Programming cable plugged in (", p, "). Looking for the radio…"))
        return
    if auto && !job_busy() && !btui.any_dialog_open() && !write_flow_active() && !verify_flow_active():
        start_detect(p)
        return
    g_new_port_prompt = true

// ── starting jobs ────────────────────────────────────────────────────────────

ref []char8 g_job_port

private ^Job prep(i32 kind, string8 port):
    ^Job j = job_prepare(kind)
    using app_keep():
        j.port = strings.clone(port)
        j.data_dir = strings.clone(g_data_dir)
        j.drivers = strings.clone(g_drivers_dir)
        j.builtin = g_builtin
        j.models = g_models
        #delete(g_job_port)
        g_job_port = strings.clone(port)
    return j

void start_detect(string8 port):
    // a quiet presence probe running on it becomes this detect
    if probe_promote():
        return
    if job_busy() || #len(port) == 0:
        return
    _ = prep(JOB_DETECT, port)
    g_page = PAGE_RADIO
    job_start()

void start_read(string8 port, string8 model_id):
    if job_busy() || #len(port) == 0:
        return
    ^Job j = prep(JOB_READ, port)
    using app_keep():
        j.want_model = strings.clone(model_id)
    g_page = PAGE_RADIO
    job_start()

void start_write(ref []u8 img, bool allow_untested):
    ^Job j = prep(JOB_WRITE, radio_port())
    using app_keep():
        j.img_in = radio.copy_image(img)
        j.want_model = strings.clone(doc_model().id)
    j.allow_untested = allow_untested
    job_start()

void start_verify_begin():
    ^Job j = prep(JOB_VERIFY_BEGIN, radio_port())
    if g_doc.open:
        using app_keep():
            j.want_model = strings.clone(doc_model().id)
    job_start()

void start_verify_step(i32 kind):
    _ = prep(kind, radio_port())
    job_start()

string8 radio_port():
    if g_radio.known && #len(g_radio.port) > 0:
        return g_radio.port
    return best_port()

// ── collecting results ───────────────────────────────────────────────────────

i32 g_last_kind
i32 g_last_err
i32 g_last_link
ref []char8 g_last_msg
bool g_read_done

private void collect_job():
    if job_state() != JS_DONE:
        return
    ^Job j = job()
    job_collect()
    g_last_kind = j.kind
    g_last_err = j.err
    g_last_link = j.link_err
    using app_keep():
        #delete(g_last_msg)
        g_last_msg = strings.clone(j.message)
    btui.request_frame()
    if j.kind == JOB_UPDATE || j.kind == JOB_ROLLBACK:
        settings_job_done(j)
        return
    if j.kind == JOB_VERIFY_BEGIN || j.kind == JOB_VERIFY_WRITE || j.kind == JOB_VERIFY_RESTORE:
        verify_job_done(j)
        return
    if j.kind == JOB_WRITE:
        write_job_done(j)
        return
    if j.err == JERR_AMBIGUOUS:
        which_radio_open(j)
        return
    if j.quiet && j.err != JERR_NONE:
        // a background presence probe: no checklist, just try again later
        probe_failed(j)
        return
    if j.err != JERR_NONE && j.err != JERR_BACKUP:
        if j.err == JERR_NO_RADIO || j.err == JERR_SESSION || (j.err == JERR_LINK && (radio.LinkError(j.link_err) == radio.LinkError.NO_ANSWER || radio.LinkError(j.link_err) == radio.LinkError.IO)):
            probe_lost(j.port)
        error_open(j.err, j.link_err, j.port)
        return
    probe_found(j.port)
    radio_set(j.model_used, j.rid, j.nickname, j.port, j.how, j.seen, j.fast_path)
    if j.quiet:
        btui.snackbar_show(#format("Found ", model_label(j.model_used), " on ", j.port, "."))
    if j.kind == JOB_READ:
        write_flow_close()
        string8 title = #format(radio_title(), " · read ", now_text())
        doc_open(j.model_used, j.img, SRC_RADIO, title, j.backup)
        doc_set_status(j.fingerprint, j.status_by, j.status_detail)
        g_read_done = true
        g_page = PAGE_CHANNELS
        if j.err == JERR_BACKUP:
            btui.snackbar_show("Read the radio, but the backup could not be saved. Check the data folder in Settings.")
        else:
            btui.snackbar_show(#format("Read ", used_count(), " channels. Backup saved."), "Show")

string8 now_text():
    return when_text(i64(btui.now()) + unix_start())

private i64 g_unix0

i64 unix_start():
    return g_unix0

void snack_action():
    reveal(path_join2(g_data_dir, "backups"))

i32 main(i32 argc, ^rawptr argv):
    []string8 args = os.args(argc, argv)
    using app_keep():
        for i in 1..<#len(args):
            string8 a = args[i]
            bool more = i + 1 < #len(args)
            if a == "--dark":
                btui.set_dark(true)
                g_theme_forced = true
                g_theme_choice = 2
            else if a == "--light":
                btui.set_dark(false)
                g_theme_forced = true
                g_theme_choice = 1
            else if a == "--no-watch":
                g_watch = false
                g_probe_on = false
            else if a == "--no-probe":
                g_probe_on = false
            else if a == "--builtin":
                g_builtin = true
            else if a == "--models" && more:
                g_arg_models = strings.clone(args[i + 1])
            else if a == "--data" && more:
                g_arg_data = strings.clone(args[i + 1])
            else if a == "--library" && more:
                g_arg_library = strings.clone(args[i + 1])
            else if a == "--drivers" && more:
                g_drivers_dir = strings.clone(args[i + 1])
            else if a == "--port" && more:
                g_port_override = strings.clone(args[i + 1])
            else if a == "--page" && more:
                g_start_page = strings.clone(args[i + 1])
            else if a == "--shot" && more:
                g_shot = strings.clone(args[i + 1])
    g_unix0 = unix_now()
    btui.run(1440, 900, "beautalks", app_init, app_frame)
    return 0

ref []char8 g_shot
