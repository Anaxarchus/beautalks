<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  beautalks - radio programming software
  Copyright (C) 2026 Anaxarchus. Licensed under the GNU GPL v3 or later.
  Template: build.sh fills @VERSION@, @BUILD@, @MIN_MACOS@ and writes
  beautalks.app/Contents/Info.plist.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>beautalks</string>
	<key>CFBundleExecutable</key>
	<string>beautalks</string>
	<key>CFBundleIconFile</key>
	<string>beautalks</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.anaxarchus.beautalks</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>beautalks</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>@MIN_MACOS@</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright (C) 2026 Anaxarchus. Licensed under the GNU GPL v3 or later.</string>
</dict>
</plist>
